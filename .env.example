# Backend Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (required for Render deployment)
# For local development, use SQLite path
# For Render production, use Postgres connection string from Render dashboard
# Example: postgresql://user:password@host:5432/fplgeek
DATABASE_URL=

# Data Directory (local development only)
DATA_DIR=./data

# FPL API Configuration (optional, defaults work fine)
# FPL_API_BASE=https://fantasy.premierleague.com/api/
