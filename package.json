{
  "name": "fplgeek",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite frontend",
    "dev:backend": "cd backend && ./venv/bin/python -m uvicorn main:app --reload --port 3000",
    "build": "npm --prefix frontend run build",
    "lint": "eslint frontend/src",
    "preview": "vite preview --root frontend",
    "pipeline:local": "cd backend && ./venv/bin/python scripts/fetch_data.py && ./venv/bin/python scripts/preprocess.py && ./venv/bin/python scripts/train_predict.py && ./venv/bin/python scripts/import_neon.py"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "react": "^19.2.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "copy-webpack-plugin": "^13.0.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
